# Normalização geral — todo arquivo texto vira LF no repositório
* text=auto eol=lf

# Exceções: scripts Windows mantêm CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binários — nunca normalizar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.war binary
*.rar binary

# Linguagens específicas (reforço explícito)
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Migrations do Flyway
src/main/resources/db/migration/*.sql text eol=lf